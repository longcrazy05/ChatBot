# Google Gemini API Key
# Sao chép file này thành .env và điền API Key thực tế của bạn
# Lấy API Key miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Tavily 1.000 lượt search / tháng (reset mỗi 30 ngày kể từ ngày đăng ký hoặc theo chu kỳ tháng)
TAVILY_API_KEY=

ALLOWED_DOMAINS_FILE=allowed_domains.txt
